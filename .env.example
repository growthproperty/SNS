# X (Twitter) API v2 - Basic tier以上が必要
# https://developer.twitter.com/en/portal/dashboard で取得
X_BEARER_TOKEN=your_bearer_token_here

# Anthropic API Key
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LINE Messaging API
# 取得手順: https://developers.line.biz/ja/services/messaging-api/
# 1. LINE Developers Console でプロバイダー作成
# 2. Messaging API チャンネル作成
# 3. チャンネル基本設定 → チャンネルシークレット をコピー
# 4. Messaging API設定 → チャンネルアクセストークン（長期）を発行
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# 収集設定（任意）
MIN_LIKE_COUNT=1000
MIN_QUOTE_COUNT=100
MAX_RESULTS_PER_SEARCH=100
